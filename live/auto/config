#!/bin/sh
# Configuración de live-build para FinanzasOS (Debian 13 "trixie", amd64)
set -e
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --bootloaders "syslinux grub-efi" \
    --bootappend-live "boot=live components quiet splash locales=es_ES.UTF-8 keyboard-layouts=es timezone=Europe/Madrid hostname=finanzasos username=trader user-fullname=Trader" \
    --iso-application "FinanzasOS" \
    --iso-publisher "FinanzasOS - terminal financiera libre" \
    --iso-volume "FinanzasOS" \
    --image-name finanzasos \
    --debian-installer none \
    --firmware-binary true \
    --firmware-chroot true \
    --security true \
    --updates true \
    --memtest none \
    --win32-loader false \
    --cache true \
    "${@}"
