#!/usr/bin/env bash
# =============================================================
#  finanzas-mode — entorno "Finanzas" para el escritorio actual (sin reiniciar)
#    on      : fondo financiero, ticker en vivo arriba a la izquierda (conky),
#              servidor de datos y terminal FinanzasOS
#    off     : restaura el fondo anterior y cierra todo lo anterior
#    toggle  : alterna
#    status  : código de salida 0 si está activo
# =============================================================
set -u
SELF_DIR="$(dirname "$(readlink -f "$0")")"
APP_DIR="$(readlink -f "$SELF_DIR/..")"
STATE_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/finanzas-mode"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/finanzasos"
notify() { notify-send -a FinanzasOS -i "$APP_DIR/finanzas/static/logo.svg" "$1" "${2:-}" 2>/dev/null || true; }
active() { [ -f "$STATE_DIR/active" ]; }

wallpaper() {
    mkdir -p "$CACHE"
    local res w h png
    res=$(xrandr --current 2>/dev/null | awk '/\*/{print $1; exit}')
    w=${res%x*}; h=${res#*x}
    [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || { w=1920; h=1080; }
    png="$CACHE/wallpaper-${w}x${h}.png"
    if [ ! -f "$png" ] || [ "$APP_DIR/branding/make_wallpaper.py" -nt "$png" ]; then
        python3 "$APP_DIR/branding/make_wallpaper.py" "$CACHE/wallpaper.svg" "$w" "$h" >/dev/null &&
            rsvg-convert -w "$w" -h "$h" "$CACHE/wallpaper.svg" -o "$png" 2>/dev/null ||
            png="$APP_DIR/branding/wallpaper.png"
    fi
    echo "$png"
}

on() {
    if active; then "$APP_DIR/bin/finanzas" panel; return; fi
    mkdir -p "$STATE_DIR" "$CACHE"
    # 1) Fondo de pantalla (se guarda el actual para restaurarlo)
    [ -f "$HOME/.fehbg" ] && cp -p "$HOME/.fehbg" "$STATE_DIR/fehbg.bak"
    local wp; wp=$(wallpaper)
    if command -v feh >/dev/null; then feh --bg-fill "$wp"          # bspwm / gestores con feh
    elif command -v xfconf-query >/dev/null; then                    # XFCE
        xfconf-query -c xfce4-desktop -l | grep 'last-image$' > "$STATE_DIR/xfce-props"
        while read -r p; do xfconf-query -c xfce4-desktop -p "$p" > "$STATE_DIR/xfce-$(echo "$p" | tr / _)" 2>/dev/null
            xfconf-query -c xfce4-desktop -p "$p" -s "$wp"; done < "$STATE_DIR/xfce-props"
    fi
    # 2) Ticker en tiempo real (conky) en la esquina superior izquierda
    if command -v conky >/dev/null; then
        sed "s#FINANZAS_DIR#$APP_DIR#g" "$APP_DIR/conky/finanzas.conkyrc" > "$CACHE/conkyrc"
        setsid -f conky -c "$CACHE/conkyrc" >/dev/null 2>&1
    else
        notify "Falta conky" "Instálalo para ver el ticker: sudo pacman -S conky"
    fi
    touch "$STATE_DIR/active"
    # 3) Servidor de datos + terminal
    "$APP_DIR/bin/finanzas" --server
    notify "Modo Finanzas activo" "Abriendo cada programa en su escritorio: 1 panel · 2 gráficos · 3 favoritas · 4 análisis y mercados · 5 sentimiento · 6 backtest · 7 optimizador · 8 calculadoras"
    "$APP_DIR/bin/finanzas" --escritorios
}

off() {
    active || return 0
    pkill -f "conky -c $CACHE/conkyrc" 2>/dev/null
    pkill -f -- "--user-data-dir=${XDG_CONFIG_HOME:-$HOME/.config}/finanzasos-browser" 2>/dev/null
    "$APP_DIR/bin/finanzas" --stop
    if [ -f "$STATE_DIR/fehbg.bak" ]; then
        cp -p "$STATE_DIR/fehbg.bak" "$HOME/.fehbg"; sh "$HOME/.fehbg" >/dev/null 2>&1
    elif [ -f "$STATE_DIR/xfce-props" ]; then
        while read -r p; do f="$STATE_DIR/xfce-$(echo "$p" | tr / _)"; [ -s "$f" ] && xfconf-query -c xfce4-desktop -p "$p" -s "$(cat "$f")"; done < "$STATE_DIR/xfce-props"
    fi
    rm -rf "$STATE_DIR"
    notify "Modo Finanzas desactivado" "Fondo y escritorio restaurados."
}

case "${1:-toggle}" in
    on) on ;;
    off) off ;;
    toggle) if active; then off; else on; fi ;;
    status) active ;;
    *) echo "Uso: $0 on|off|toggle|status" >&2; exit 1 ;;
esac
